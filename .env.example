# Optional Docker Compose settings. Copy this file to .env, or export the
# variables in the shell that starts the stack.
NEXTFLOW_RUNNER_CONCURRENCY=1

# Set this only when NEXTFLOW_EXECUTOR=slurm and Nextflow must run on a cluster
# head node. The SSH invocation must be non-interactive.
NEXTFLOW_SLURM_SSH=

# Executable available on the remote cluster head. This is intentionally a
# single executable path/name, not a shell setup command.
NEXTFLOW_REMOTE_EXEC=nextflow
