###############################################################################
# Refer to `./src/config.js` to see all supported environment variables.      #
###############################################################################
VITE_NAME=EDGEV3
VITE_USER_AUTH_ENABLED=true
VITE_EMAIL_NOTIFICATION_ENABLED=false

# for development only
VITE_API_URL=http://localhost:8080

# ORCiD login
VITE_IS_ORCID_AUTH_ENABLED=false
VITE_ORCID_CLIENT_ID=="__POPULATE_ME_IF_ENABLING_ORCID_AUTH__"

# feature flag for enabling/disabling bulk submissions
VITE_BULK_SUBMISSIONS_ENABLED=false
# data
VITE_FILEUPLOAD_ENABLED=true
VITE_FILEUPLOAD_FOLDER_ENABLED=true
VITE_SRADATA_ENABLED=false

# EDGEv3
VITE_DISTRIBUTION_NOTE=Distribution Statement A - Approved for public release; distribution is unlimited.

# AI result summaries
# Provider key, model, and prompts are configured in webapp/server/.env.
VITE_AI_SUMMARY_ENABLED=true

# single-user mode 
VITE_SINGLE_USER_MODE_ENABLED=true

