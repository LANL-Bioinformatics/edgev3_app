FROM mambaorg/micromamba:2.8.1-debian13-slim@sha256:fb18405d6004af757a38ec498a078240b4fd5549146990a484c28bb7e78aace4

ARG DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ENV_NAME=edgev3

USER root
RUN apt-get -y update \
    && apt-get -y install --no-install-recommends ca-certificates openssh-client vim libz-dev liblmdb-dev \
    && groupmod --gid 1000 mambauser \
    && usermod --uid 1000 --gid 1000 mambauser \
    && chown -R mambauser:mambauser /home/mambauser \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# The shared runner library ships with edge-core; this app supplies only its
# own tool definition.
COPY --chown=mambauser:mambauser ./src/edge-v3/job_runner/ /opt/edgev3-job-runner/lib/
COPY --chown=mambauser:mambauser ./src/job_runner/job_runner.py /opt/edgev3-job-runner/job_runner.py
COPY --chown=mambauser:mambauser ./src/edge-v3/workflows/ /edgev3/workflows/

USER mambauser:mambauser

# Install Nextflow and Apptainer as the unprivileged runtime user.
RUN micromamba create --name "${ENV_NAME}" --yes -c conda-forge -c bioconda python=3.12 nextflow apptainer \
    && micromamba clean --all -y \
    && echo "micromamba activate ${ENV_NAME}" >> "${HOME}/.bashrc"

# The job-runner library serves its API with FastAPI. Runtime only: the test
# dependency is intentionally excluded from the image.
RUN /opt/conda/envs/${ENV_NAME}/bin/pip install --no-cache-dir \
      "fastapi~=0.115" "uvicorn~=0.30"

ENV PATH="/opt/conda/envs/${ENV_NAME}/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/conda/envs/${ENV_NAME}/lib" \
    PYTHONUNBUFFERED=1 \
    RUNNER_TOOL=nextflow \
    RUNNER_PORT=7001 \
    NEXTFLOW_EXEC=/opt/conda/envs/edgev3/bin/nextflow \
    EDGE_JOB_RUNNER_LIB=/opt/edgev3-job-runner/lib

WORKDIR /edgev3

EXPOSE 7001

CMD ["/opt/conda/envs/edgev3/bin/python", "/opt/edgev3-job-runner/job_runner.py"]
